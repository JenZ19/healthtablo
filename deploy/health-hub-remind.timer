[Unit]
Description=Напоминания хаба здоровья дважды в день

[Timer]
# Утром — про сроки профилактики и цикл, вечером — про несделанные за
# день таблетки. Ночью не будим: уведомление в три часа никто не оценит.
OnCalendar=*-*-* 07:30:00
OnCalendar=*-*-* 18:30:00
Persistent=true

[Install]
WantedBy=timers.target
